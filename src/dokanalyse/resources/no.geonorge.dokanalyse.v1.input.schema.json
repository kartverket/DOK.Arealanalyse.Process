{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "no.geonorge.dokanalyse.v1.input.schema.json",
    "title": "AnalysisInput",
    "type": "object",
    "properties": {
        "inputGeometry": {
            "oneOf": [
                {
                    "$ref": "#/definitions/Polygon"
                },
                {
                    "$ref": "#/definitions/MultiPolygon"
                }
            ]
        },
        "requestedBuffer": {
            "type": "integer"
        },
        "theme": {
            "type": [
                "string",
                "null"
            ]
        },
        "context": {
            "type": [
                "string",
                "null"
            ]
        },
        "includeGuidance": {
            "type": "boolean"
        },
        "includeQualityMeasurement": {
            "type": "boolean"
        },
        "includeFilterChosenDOK": {
            "type": "boolean"
        },
        "includeFacts": {
            "type": "boolean"
        },
        "createBinaries": {
            "type": "boolean"
        },
        "correlationId": {
            "type": [
                "string",
                "null"
            ],
            "format": "uuid"
        }
    },
    "required": [
        "inputGeometry"
    ],
    "definitions": {
        "Position": {
            "type": "array",
            "minItems": 2,
            "items": {
                "type": "number"
            }
        },
        "LinearRing": {
            "type": "array",
            "minItems": 4,
            "items": {
                "$ref": "#/definitions/Position"
            }
        },
        "PolygonCoordinates": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/LinearRing"
            }
        },
        "Polygon": {
            "type": "object",
            "required": [
                "type",
                "coordinates"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "Polygon"
                    ]
                },
                "coordinates": {
                    "$ref": "#/definitions/PolygonCoordinates"
                },
                "bbox": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "MultiPolygon": {
            "type": "object",
            "required": [
                "type",
                "coordinates"
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": [
                        "MultiPolygon"
                    ]
                },
                "coordinates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/PolygonCoordinates"
                    }
                },
                "bbox": {
                    "type": "array",
                    "minItems": 4,
                    "items": {
                        "type": "number"
                    }
                }
            }
        }
    }
}
